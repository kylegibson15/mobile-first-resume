---
import { education, experience } from '../data/resume';
---

<section aria-labelledby="experience" class="xp">
  <h2 id="experience" class="section-head">Experience</h2>

  {experience.map((role) => (
    <article class="role reveal">
      <div class="meta">
        <h3>{role.company}</h3>
        <p class="division">{role.division}</p>
        <p class="period">
          {role.period}
          {role.current && <span class="now"><span class="now-dot" aria-hidden="true"></span>Now</span>}
        </p>
      </div>
      <div class="detail">
        <p class="title">{role.title}</p>
        <ul>
          {role.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
        <ul class="tech" aria-label={`Tools used at ${role.company}, ${role.title}`}>
          {role.tech.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </article>
  ))}

  <article class="role">
    <div class="meta"><h3>Education</h3></div>
    <div class="detail">
      <ul>
        {education.map((school) => (
          <li>{school.degree} — {school.school}{school.note ? ` (${school.note})` : ''}</li>
        ))}
      </ul>
    </div>
  </article>
</section>

<style>
  .xp {
    padding-block: var(--gap-section);
    border-top: 1px solid var(--rule);
  }

  .role {
    display: grid;
    gap: 0.75rem 3rem;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .role:last-child {
    border-bottom: 0;
  }

  @media (min-width: 48rem) {
    .role {
      grid-template-columns: 15rem 1fr;
      /* The company (display serif, --step-1) and the role title (bold
         Inter, --step-0) have different first-baseline offsets, so
         top-aligning the two columns left the two most prominent words in
         each row sitting on visibly different lines. */
      align-items: baseline;
    }
  }

  h3 {
    font-size: var(--step-1);
  }

  .division,
  .period {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .title {
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  ul {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.6rem;
  }

  li {
    max-width: var(--measure);
  }

  /* Bullet markers pick up the accent so a long list still has a colour. */
  li::marker {
    color: var(--accent);
  }

  /* "Now" beside the dates of the role that is still going. */
  .now {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-left: 0.6em;
    padding: 0.05em 0.6em 0.05em 0.5em;
    border-radius: 999px;
    background: var(--rule);
    color: var(--ink-muted);
    font-size: 0.9em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .now-dot {
    position: relative;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--live);
  }

  /* The tools each role used, as chips under its bullets. */
  ul.tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .tech li {
    max-width: none;
    padding: 0.12em 0.65em;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-raised);
  }

  @media (prefers-reduced-motion: no-preference) {
    .now-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--live);
      animation: ping 2.4s var(--ease) infinite;
    }

    @keyframes ping {
      from {
        opacity: 0.55;
        transform: scale(1);
      }
      to {
        opacity: 0;
        transform: scale(2.8);
      }
    }
  }
</style>
