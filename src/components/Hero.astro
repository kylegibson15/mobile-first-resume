---
import { profile } from '../data/resume';
---

<header class="hero">
  <p class="eyebrow"><span>{profile.title}</span><span class="place">{profile.location}</span></p>
  <h1>{profile.name}</h1>
  <p class="thesis">
    By day I lead the platform that designs and simulates a lunar lander at Blue Origin.
  </p>
  <p class="thesis thesis-night">
    At night I build robots in my garage.
  </p>
</header>

<style>
  .hero {
    padding-block: clamp(4rem, 12vh, 9rem) var(--gap-section);
  }

  /*
   * The two halves stack on a phone and sit on one line from 30rem up.
   * As a single text node the line wrapped as "SOFTWARE ENGINEERING LEAD ·"
   * / "DENVER, COLORADO" at 390px, stranding the separator at the end of
   * the first line — the first thing on the page, and it read as a typo.
   * The separator is drawn by CSS so it only exists when the two halves
   * are actually side by side.
   */
  .eyebrow {
    display: grid;
    justify-items: start;
    gap: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 30rem) {
    .eyebrow {
      display: block;
    }

    .place::before {
      content: '·';
      margin-inline: 0.6em 0.55em;
    }
  }

  h1 {
    font-size: var(--step-4);
    margin-bottom: 1.75rem;
  }

  /*
   * A step down on a phone. At --step-2 the thesis was 25px against a 39px
   * name — near enough the same size that the two competed, and the night
   * sentence spilled onto a second line for the sake of two words. At
   * --step-1 the name/thesis ratio on a phone matches the one at 1280px
   * and both sentences break where they should.
   */
  .thesis {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
    /* Own measure, in its own em, so it tracks --step-2 rather than the
       68ch --measure that is calibrated for Inter body copy. */
    max-width: 24em;
    /* Two short display sentences, so even line lengths matter more than
       avoiding a short last line. `pretty` left "my garage." alone on a
       line at 390px. */
    text-wrap: balance;
  }

  /* Declared after the base rule, not with the eyebrow's query above: same
     specificity, so source order decides. */
  @media (min-width: 30rem) {
    .thesis {
      font-size: var(--step-2);
    }
  }

  /* The night half is the differentiator, not a footnote to the day half.
     At 0.4em the pair read as one paragraph with an accidental break. */
  .thesis-night {
    margin-top: 0.7em;
  }
</style>
