---
import Icon from './Icon.astro';
import { profile } from '../data/resume';
---

<header class="hero">
  <div class="glow" aria-hidden="true"></div>

  <p class="eyebrow"><span>{profile.title}</span><span class="place">{profile.location}</span></p>
  <h1>{profile.name}</h1>
  <p class="thesis">
    By day I lead the product team behind the <span class="hl">platform</span> Blue Origin’s engineers use to design lunar landers.
  </p>
  <p class="thesis thesis-night">
    At night I build <span class="hl hl-2">robots</span> in my garage.
    <svg class="pup" viewBox="0 0 72 44" width="60" height="37" aria-hidden="true" focusable="false">
      <g class="legs" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <g class="leg l1"><path d="M20 24 L17 32 L21 40" /></g>
        <g class="leg l2"><path d="M29 24 L32 32 L28 40" /></g>
        <g class="leg l3"><path d="M43 24 L40 32 L44 40" /></g>
        <g class="leg l4"><path d="M52 24 L55 32 L51 40" /></g>
      </g>
      <rect x="14" y="10" width="44" height="15" rx="6" fill="currentColor" />
      <rect x="54" y="4" width="15" height="12" rx="4" fill="currentColor" />
      <circle cx="63" cy="9.5" r="1.9" fill="var(--paper)" />
      <path d="M14 15 L8 11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    </svg>
  </p>

  <ul class="actions" aria-label="Get in touch">
    <li>
      <a class="btn btn-primary" href={`mailto:${profile.email}`}>
        <Icon name="mail" /> Say hello <Icon name="arrow" size={15} />
      </a>
    </li>
    <li>
      <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        <Icon name="briefcase" /> LinkedIn <Icon name="arrow" size={15} />
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </li>
    <li>
      <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">
        <Icon name="code" /> GitHub <Icon name="arrow" size={15} />
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </li>
  </ul>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4rem, 12vh, 9rem) var(--gap-section);
  }

  /*
   * Two soft blooms, one in the accent and one in the warm gold borrowed from
   * AmigoWeGo's icon, sitting behind the name. Low opacity: it should read as
   * light on the paper, never as a graphic.
   */
  .glow {
    position: absolute;
    inset: -10% -45vw 0 25%;
    z-index: -1;
    background:
      radial-gradient(38% 46% at 62% 34%, color-mix(in srgb, var(--accent) 20%, transparent), transparent 72%),
      radial-gradient(30% 40% at 88% 62%, color-mix(in srgb, var(--sun) 22%, transparent), transparent 70%);
    filter: blur(18px);
  }

  /*
   * The two halves stack on a phone and sit on one line from 30rem up.
   * As a single text node the line wrapped as "SOFTWARE ENGINEERING LEAD ·"
   * / "DENVER, COLORADO" at 390px, stranding the separator at the end of
   * the first line — the first thing on the page, and it read as a typo.
   * The separator is drawn by CSS so it only exists when the two halves
   * are actually side by side.
   */
  .eyebrow {
    display: grid;
    justify-items: start;
    gap: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 30rem) {
    .eyebrow {
      display: block;
    }

    .place::before {
      content: '·';
      margin-inline: 0.6em 0.55em;
    }
  }

  h1 {
    font-size: var(--step-4);
    margin-bottom: 1.75rem;
  }

  /*
   * A step down on a phone. At --step-2 the thesis was 25px against a 39px
   * name — near enough the same size that the two competed, and the night
   * sentence spilled onto a second line for the sake of two words. At
   * --step-1 the name/thesis ratio on a phone matches the one at 1280px
   * and both sentences break where they should.
   */
  .thesis {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
    /* Own measure, in its own em, so it tracks --step-2 rather than the
       68ch --measure that is calibrated for Inter body copy. */
    max-width: 24em;
    /* Two short display sentences, so even line lengths matter more than
       avoiding a short last line. `pretty` left "my garage." alone on a
       line at 390px. */
    text-wrap: balance;
  }

  /* Declared after the base rule, not with the eyebrow's query above: same
     specificity, so source order decides. */
  @media (min-width: 30rem) {
    .thesis {
      font-size: var(--step-2);
    }
  }

  /* The night half is the differentiator, not a footnote to the day half.
     At 0.4em the pair read as one paragraph with an accidental break. */
  .thesis-night {
    margin-top: 0.7em;
  }

  /* A marker-pen stroke under the two phrases the page is about. Drawn as a
     background so the text stays real text, selectable and readable. */
  .hl {
    background-image: linear-gradient(
      color-mix(in srgb, var(--accent) 34%, transparent),
      color-mix(in srgb, var(--accent) 34%, transparent)
    );
    background-repeat: no-repeat;
    background-position: 0 90%;
    background-size: 100% 0.4em;
    border-radius: 0.1em;
    padding-inline: 0.06em;
    margin-inline: -0.06em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hl-2 {
    background-image: linear-gradient(
      color-mix(in srgb, var(--sun) 46%, transparent),
      color-mix(in srgb, var(--sun) 46%, transparent)
    );
  }

  /* The garage dog. Same ink as the text so it reads as part of the line. */
  .pup {
    display: inline-block;
    vertical-align: -0.18em;
    margin-left: 0.35em;
    color: var(--ink);
    overflow: visible;
  }

  .leg {
    transform-box: fill-box;
    transform-origin: 50% 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin-top: 2.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* One staggered entrance on load; nothing loops except the legs. */
    .eyebrow,
    h1,
    .thesis,
    .actions {
      animation: enter 0.7s var(--ease) both;
    }

    h1 {
      animation-delay: 0.06s;
    }

    .thesis {
      animation-delay: 0.16s;
    }

    .thesis-night {
      animation-delay: 0.26s;
    }

    .actions {
      animation-delay: 0.38s;
    }

    .hl {
      animation: draw 0.9s var(--ease) 0.7s both;
    }

    .hl-2 {
      animation-delay: 0.95s;
    }

    .leg {
      animation: step 0.9s ease-in-out infinite alternate;
    }

    .l2,
    .l3 {
      animation-delay: -0.45s;
    }

    .glow {
      animation: drift 14s ease-in-out infinite alternate;
    }

    @keyframes enter {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
    }

    @keyframes draw {
      from {
        background-size: 0% 0.4em;
      }
    }

    @keyframes step {
      from {
        transform: rotate(-16deg);
      }
      to {
        transform: rotate(16deg);
      }
    }

    @keyframes drift {
      to {
        transform: translate(-3%, 4%) scale(1.06);
      }
    }
  }
</style>
