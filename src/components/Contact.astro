---
import Icon from './Icon.astro';
import { profile } from '../data/resume';

// Handles for display: the URLs are the truth, the handles are a reading of them.
const handle = (url: string) => new URL(url).pathname.replace(/^\/(in\/)?/, '').replace(/\/$/, '');
---

<section aria-labelledby="contact" class="contact">
  <div class="panel reveal">
    <div class="glow" aria-hidden="true"></div>
    <h2 id="contact">Let’s talk.</h2>
    <ul>
      <li>
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>
          <Icon name="mail" />
          <span>Email</span>
          <span class="btn-host">{profile.email}</span>
        </a>
      </li>
      <li>
        <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="briefcase" />
          <span>LinkedIn</span>
          <span class="btn-host">{handle(profile.linkedin)}</span>
          <span class="btn-arrow"><Icon name="arrow" size={15} /></span>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </li>
      <li>
        <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">
          <Icon name="code" />
          <span>GitHub</span>
          <span class="btn-host">{handle(profile.github)}</span>
          <span class="btn-arrow"><Icon name="arrow" size={15} /></span>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </li>
    </ul>
    <p class="where"><Icon name="pin" size={15} /> {profile.location}</p>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--gap-section);
    border-top: 1px solid var(--rule);
  }

  /* The last thing on the page gets a surface of its own, warmed with the same
     two blooms as the top, so the page ends where it began. */
  .panel {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: clamp(1.75rem, 5vw, 3.5rem);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 20px;
  }

  .glow {
    position: absolute;
    inset: -30% -10% -30% 40%;
    z-index: -1;
    background:
      radial-gradient(45% 55% at 60% 45%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 72%),
      radial-gradient(35% 45% at 90% 75%, color-mix(in srgb, var(--sun) 20%, transparent), transparent 70%);
    filter: blur(16px);
  }

  h2 {
    font-size: var(--step-4);
    margin-bottom: 1.75rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin-bottom: 1.75rem;
  }

  .where {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
