---
import { PRACTICES } from '../data/practices';
---

<section aria-labelledby="how" class="how">
  <h2 id="how" class="section-head">How I work</h2>
  <div class="grid">
    {PRACTICES.map((practice) => (
      <article>
        <h3>{practice.title}</h3>
        <p>{practice.body}</p>
        <figure>
          <blockquote>
            {practice.quote && <p>{practice.quote}</p>}
            {practice.items && (
              <ul class="quoted-rows">
                {practice.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </blockquote>
          <figcaption>{practice.source}</figcaption>
        </figure>
      </article>
    ))}
  </div>
</section>

<style>
  .how {
    padding-block: var(--gap-section);
    border-top: 1px solid var(--rule);
  }

  .grid {
    display: grid;
    gap: 3rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto auto;
      /* Row gap must stay zero: the three rows are the inside of each
         column, and h3/figure already carry their own spacing. A row-gap
         here opens a hole under every title. */
      column-gap: 2.5rem;
      row-gap: 0;
    }

    /* The three bodies are different lengths, so the quotation blocks
       started at three different heights — a ragged row of the one element
       that is supposed to look like a set. Subgrid puts the titles, the
       bodies and the artifacts each on a shared line. */
    .grid > article {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      align-content: start;
    }
  }

  h3 {
    font-size: var(--step-1);
    margin-bottom: 0.75rem;
  }

  figure {
    margin: 1.25rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--rule);
  }

  blockquote {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  blockquote p {
    max-width: none;
  }

  /* Table rows quoted as rows, one per line — not run together into prose.
     No bullets: the source is a table, and a marker would be an addition to
     what is presented as verbatim text. */
  .quoted-rows {
    list-style: none;
    padding: 0;
  }

  figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    /* "home-claw/README.md, hardware table" otherwise leaves "table" alone
       on a line of its own in the third column. */
    text-wrap: pretty;
  }
</style>
