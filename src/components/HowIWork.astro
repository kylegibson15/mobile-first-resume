---
import Icon from './Icon.astro';
import { PRACTICES } from '../data/practices';

// One glyph per practice, in the order practices.ts lists them.
const GLYPHS = ['stairs', 'bolt', 'seal'] as const;
---

<section aria-labelledby="how" class="how">
  <h2 id="how" class="section-head">How I work</h2>
  <div class="grid">
    {PRACTICES.map((practice, index) => (
      <article class="reveal">
        <span class="glyph"><Icon name={GLYPHS[index] ?? 'seal'} size={22} /></span>
        <h3>{practice.title}</h3>
        <p>{practice.body}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .how {
    padding-block: var(--gap-section);
    border-top: 1px solid var(--rule);
  }

  .grid {
    display: grid;
    gap: 3rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto auto;
      /* Row gap must stay zero: the three rows (glyph, title, body) are the
         inside of each column, and each already carries its own spacing. A row-gap
         here opens a hole under every title. */
      column-gap: 2.5rem;
      row-gap: 0;
    }

    /* Subgrid keeps the three titles on one line and the three bodies
       starting on one line, whatever their lengths. */
    .grid > article {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      align-content: start;
    }
  }

  article {
    padding: 1.5rem 1.5rem 1.75rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 14px;
    transition:
      transform 0.25s var(--ease),
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  article:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--lift);
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 1rem;
    border-radius: 0.75rem;
    color: var(--accent);
    background: var(--accent-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    article,
    article:hover {
      transform: none;
    }
  }

  h3 {
    font-size: var(--step-1);
    margin-bottom: 0.75rem;
  }
</style>
